<%- include('../partials/top') %>
<div class="auth-split">
  <%- include("../partials/auth-visual", { visual: "villa-2" }) %>
  <div class="auth-wrap">
    <div class="auth-card">
      <% if (admin) { %><span class="chip chip-navy mb-2">🔒 <%= t('nav.admin') %></span><% } %>
      <h1 class="mt-1"><%= title %></h1>
      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
      <form class="form" method="post" action="<%= action %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label for="l-email"><%= t('auth.email') %></label><input id="l-email" name="email" type="email" required autocomplete="username" value="<%= email %>"></div>
        <div><label for="l-pass"><%= t('auth.password') %></label><input id="l-pass" name="password" type="password" required autocomplete="current-password"></div>
        <button class="btn btn-gold btn-block" type="submit"><%= t('auth.submit_login') %></button>
      </form>
      <p class="auth-foot"><a href="/forgot-password"><%= t('auth.forgot_link') %></a></p>
      <% if (!admin) { %><p class="auth-foot"><%= t('auth.no_account') %> <a href="/register"><%= t('nav.register') %></a></p><% } %>
    </div>
  </div>
</div>
<%- include("../partials/bottom") %>
