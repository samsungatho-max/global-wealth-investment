<%- include('../partials/top') %>
<div class="container">
  <div class="auth-wrap">
    <div class="auth-card">
      <div style="font-size:2.4rem;line-height:1">✉️</div>
      <h1 class="mt-1"><%= t('auth.verify_title') %></h1>

      <% if (!st.issued) { %>
        <div class="alert alert-info"><%= t('auth.verify_none') %></div>
      <% } else if (['relay_accepted', 'delivered', 'deferred'].includes(st.mailStatus)) { %>
        <div class="alert alert-success" role="status"><%= t('auth.verify_sent', { email: maskedEmail }) %></div>
      <% } else if (st.mailStatus === 'queued') { %>
        <div class="alert alert-info" role="status"><%= t('auth.verify_sending') %></div>
      <% } else { %>
        <div class="alert alert-error" role="alert"><%= t('auth.verify_send_failed') %></div>
      <% } %>

      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

      <p class="muted"><%= t('auth.verify_code_intro', { email: maskedEmail, min: ttl }) %></p>
      <form class="form" method="post" action="/verify-email" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div>
          <label for="v-code"><%= t('auth.verify_code_label') %></label>
          <input id="v-code" class="code-input" name="code" type="text" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" required autocomplete="one-time-code" autofocus>
        </div>
        <button class="btn btn-gold btn-block" type="submit"><%= t('auth.verify_submit') %></button>
      </form>

      <form method="post" action="/verify-email/resend" class="mt-3 text-center">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-ghost" type="submit" data-countdown="<%= st.waitSeconds || 0 %>" data-label="<%= st.issued ? t('auth.verify_resend') : t('auth.verify_send') %>" <%= st.waitSeconds ? 'disabled' : '' %>>
          <%= st.issued ? t('auth.verify_resend') : t('auth.verify_send') %><% if (st.waitSeconds) { %> (<%= st.waitSeconds %> s)<% } %>
        </button>
      </form>
      <p class="auth-foot small"><%= t('auth.verify_help') %> <a href="/contact"><%= t('nav.contact') %></a></p>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
