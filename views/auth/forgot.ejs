<%- include('../partials/top') %>
<div class="container">
  <div class="auth-wrap">
    <div class="auth-card">
      <h1><%= t('auth.forgot_title') %></h1>
      <p class="muted"><%= t('auth.forgot_text') %></p>
      <form class="form" method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label for="fp-email"><%= t('auth.email') %></label><input id="fp-email" name="email" type="email" required autocomplete="email"></div>
        <button class="btn btn-gold btn-block" type="submit"><%= t('auth.forgot_submit') %></button>
      </form>
      <p class="auth-foot"><a href="/login">← <%= t('nav.login') %></a></p>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
