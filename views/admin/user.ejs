<%- include('../partials/top', { bodyClass: 'admin-body' }) %>
<div class="container dash">
  <%- include('../partials/admin-nav') %>
  <div>
    <div class="dash-head">
      <div><a class="small" href="/admin/users">← Comptes clients</a><h1><%= u.full_name %></h1><p class="pf-dim small mb-0">Compte <span class="mono"><%= acctNo(u.id) %></span> · <%= u.email %></p></div>
      <div class="actions">
        <span class="chip <%= u.status === 'active' ? 'chip-success' : 'chip-danger' %>"><%= u.status === 'active' ? 'Actif' : 'Suspendu' %></span>
        <span class="chip <%= { approved: 'chip-success', pending: 'chip-warning', rejected: 'chip-danger' }[u.kyc_status] || '' %>">KYC : <%= t('kyc.' + u.kyc_status) %></span>
        <% if (u.totp_enabled) { %><span class="chip chip-navy">2FA</span><% } %>
      </div>
    </div>

    <nav class="adm-subnav" aria-label="Rubriques de la fiche">
      <% [['identity', 'Identité'], ['account', 'Compte'], ['portfolio', 'Portefeuille'], ['deposit', 'Dépôts'], ['withdrawals', 'Retraits'], ['invest', 'Investissements'], ['valuations', 'Performance'], ['transactions', 'Transactions'], ['docs', 'Documents'], ['notify', 'Notifications'], ['activity', 'Journal d\'activité']].forEach(function (x) { %><a href="#<%= x[0] %>"><%= x[1] %></a><% }) %>
    </nav>

    <div class="grid grid-2 panel" id="identity">
      <div class="card">
        <h2 style="font-size:1.1rem">Profil</h2>
        <dl class="kv">
          <dt>E-mail</dt><dd><%= u.email %> <%= u.email_verified_at ? '✓' : '(non vérifié)' %></dd>
          <dt>Téléphone</dt><dd><%= u.phone %></dd>
          <dt>Pays</dt><dd><%= countryName(u.country) %></dd>
          <dt>Langue</dt><dd><%= u.lang.toUpperCase() %></dd>
          <dt>Rôle</dt><dd><%= u.role %></dd>
          <dt>Inscription</dt><dd><%= fmtDate(u.created_at, true) %></dd>
          <dt>Dernière connexion</dt><dd><%= fmtDate(u.last_login_at, true) %></dd>
        </dl>
        <div class="actions mt-2">
          <% if (u.id !== user.id) { %>
          <form method="post" action="/admin/users/<%= u.id %>/status" data-confirm="Confirmer ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= u.status === 'active' ? 'suspended' : 'active' %>"><button class="btn <%= u.status === 'active' ? 'btn-danger' : 'btn-navy' %> btn-sm" type="submit"><%= u.status === 'active' ? 'Suspendre le compte' : 'Réactiver le compte' %></button></form>
          <form method="post" action="/admin/users/<%= u.id %>/role" data-confirm="Modifier le rôle de ce compte ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="role" value="<%= u.role === 'admin' ? 'investor' : 'admin' %>"><button class="btn btn-ghost btn-sm" type="submit"><%= u.role === 'admin' ? 'Retirer le rôle admin' : 'Nommer administrateur' %></button></form>
          <% } %>
          <% if (!u.email_verified_at) { %><form method="post" action="/admin/users/<%= u.id %>/resend-code"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-gold btn-sm" type="submit">Renvoyer le code de confirmation</button></form>
          <a class="btn btn-ghost btn-sm" href="/admin/emails?q=<%= encodeURIComponent(u.email) %>">Journal d'envoi</a><% } %>
          <% if (!u.email_verified_at) { %><form method="post" action="/admin/users/<%= u.id %>/verify-email" data-confirm="Confirmer manuellement l'adresse sans code ? À n'utiliser qu'après vérification par un autre moyen."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm" type="submit">Marquer l'e-mail vérifié</button></form><% } %>
        </div>
      </div>
      <div class="card" id="account">
        <h2 style="font-size:1.1rem">Compte <span class="mono"><%= acctNo(u.id) %></span> — situation calculée depuis la base</h2>
        <dl class="kv">
          <dt>Solde en compte</dt><dd><strong><%= usd(s.cash) %></strong></dd>
          <dt>Disponible</dt><dd><%= usd(s.available) %><% if (s.reserved) { %> <span class="muted small">(<%= usd(s.reserved) %> réservés)</span><% } %></dd>
          <dt>Capital investi (actif)</dt><dd><%= usd(s.invested) %></dd>
          <dt>Valeur estimée</dt><dd><%= usd(s.value) %></dd>
        </dl>
        <h3 class="mt-2" style="font-size:.95rem">Vérifications KYC</h3>
        <% if (!kycs.length) { %><p class="muted small">Aucune soumission.</p><% } %>
        <% kycs.forEach(function (k) { %>
          <div class="small">#<%= k.id %> · <%= fmtDate(k.created_at) %> · <%= t('kyc.' + k.doc_type) %> · <strong><%= t('kyc.' + k.status) %></strong>
            · <a href="/admin/kyc/<%= k.id %>/file/id">pièce d'identité</a> · <a href="/admin/kyc/<%= k.id %>/file/address">justificatif</a>
            <% if (k.review_note) { %><div class="muted">Note : <%= k.review_note %></div><% } %></div>
        <% }) %>
      </div>
    </div>

    <section class="panel" id="portfolio">
      <div class="panel-head"><h2>Évolution du portefeuille / gestion de la performance</h2></div>
      <% var ps = pf.stats; var drafts = history.filter(function (v) { return Number(v.published) === 0; }); var signed = function (c) { return (c > 0 ? '+' : c < 0 ? '−' : '') + usd(Math.abs(c)); }; %>
      <div class="pf adm-pf" data-pf data-locale="fr-FR" data-currency="USD" data-rate="1" data-points="<%= JSON.stringify(pf.points.map(function (p) { return [p.t, p.value, p.net]; })) %>" data-now="<%= now %>">
        <div class="adm-kpis">
          <div><span class="pf-lab">Capital versé (dépôts nets)</span><strong><%= usd(ps.net) %></strong></div>
          <div><span class="pf-lab">Valeur actuelle</span><strong><%= usd(ps.value) %></strong></div>
          <div><span class="pf-lab">Gains / pertes</span><strong class="<%= ps.pl > 0 ? 'pos' : ps.pl < 0 ? 'neg' : '' %>"><%= signed(ps.pl) %></strong></div>
          <div><span class="pf-lab">Performance</span><strong class="<%= ps.perf > 0 ? 'pos' : ps.perf < 0 ? 'neg' : '' %>"><%= pct(ps.perf) %></strong></div>
          <div><span class="pf-lab">Dernière valorisation publiée</span><strong><%= pf.lastValuationAt ? fmtDate(pf.lastValuationAt, true) : '—' %></strong></div>
          <div><span class="pf-lab">Variation du jour</span><strong class="<%= ps.today > 0 ? 'pos' : ps.today < 0 ? 'neg' : '' %>"><%= signed(ps.today) %></strong></div>
        </div>

        <div class="adm-pf-grid">
          <div class="pf-card pf-chart-card">
            <div class="pf-chart-top">
              <div>
                <span class="pf-lab">Vue du client</span>
                <div class="pf-chart-val"><strong data-chart-value><%= usd(ps.value) %></strong><em data-chart-change></em></div>
                <small class="pf-dim" data-chart-date>&nbsp;</small>
              </div>
              <div class="pf-ranges" role="group" aria-label="Période">
                <% [['1H', 3600e3], ['1D', 86400e3], ['1W', 7 * 86400e3], ['1M', 30 * 86400e3], ['3M', 91 * 86400e3], ['6M', 182 * 86400e3], ['1Y', 365 * 86400e3], ['ALL', 0]].forEach(function (r) { %><button type="button" data-range="<%= r[1] %>" aria-pressed="<%= r[0] === 'ALL' %>"><%= r[0] %></button><% }) %>
              </div>
            </div>
            <div class="pf-legend"><span><i></i>Valeur du portefeuille</span><span><i class="net"></i>Dépôts nets</span><span data-preview-legend hidden><i class="pv"></i>Aperçu avant publication</span></div>
            <div class="pf-chart" data-chart data-empty="Aucune opération confirmée : le graphique apparaîtra après le premier dépôt confirmé." data-flat="Aucune variation sur cette période." data-change-label="Variation de la valeur sur la période, dépôts et retraits compris :" data-pl-label="de gain / perte sur la période">
              <svg viewBox="0 0 900 340" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="pf-up" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#12a37a" stop-opacity=".38"/><stop offset="1" stop-color="#12a37a" stop-opacity="0"/></linearGradient>
                  <linearGradient id="pf-down" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff6b5e" stop-opacity=".32"/><stop offset="1" stop-color="#ff6b5e" stop-opacity="0"/></linearGradient>
                </defs>
                <g data-grid></g>
                <path data-area></path>
                <path class="pf-net" data-net></path>
                <path class="pf-line" data-line></path>
                <path class="pf-preview" data-preview></path>
                <line class="pf-cross" data-cross x1="0" x2="0" y1="0" y2="340"></line>
              </svg>
              <div class="pf-axis-y" data-axis-y></div>
              <div class="pf-axis-x" data-axis-x></div>
              <span class="pf-dot" data-dot></span>
              <p class="pf-empty" data-empty-msg hidden></p>
            </div>
            <div class="pf-chart-foot"><span>Heures affichées en UTC.</span><span class="pf-dim">Courbe calculée à partir des transactions confirmées et des valorisations publiées. Elle ne peut pas être modifiée directement.</span></div>
          </div>

          <div class="pf-card adm-editor">
            <div class="pf-card-head"><h2>Éditeur de valorisation</h2></div>
            <% if (!s.active.length) { %>
              <p class="alert alert-info small mb-0">Ce client n'a aucune position ouverte : son portefeuille n'est constitué que de liquidités, dont la valeur ne varie pas. Une valorisation se rattache toujours à un investissement enregistré (rubrique « Investissements »).</p>
            <% } else { %>
            <form class="form" method="post" action="/admin/investments/<%= s.active[0].id %>/valuations" data-val-editor data-preview-url="/admin/users/<%= u.id %>/portfolio-preview.json" data-today="<%= today %>">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="from" value="editor">
              <div><label for="ve-inv">Position valorisée</label>
                <select id="ve-inv" data-ve-inv><% s.active.forEach(function (i) { %><option value="<%= i.id %>" data-current="<%= i.current_value %>" data-start="<%= i.start_date %>" data-label="<%= usd(i.current_value) %>">#<%= i.id %> · <%= i.title %></option><% }) %></select></div>
              <div class="form-row form-row-2">
                <div><label for="ve-freq">Fréquence de la source</label>
                  <select id="ve-freq" data-ve-freq><option value="week">Semaine</option><option value="day" selected>Jour</option><option value="hour">Heure</option><option value="minute">Minute</option><option value="second">Seconde</option></select></div>
                <div><label for="ve-date">Date de valeur</label><input id="ve-date" name="date" type="date" required max="<%= today %>" value="<%= today %>" data-ve-date></div>
              </div>
              <div data-ve-time-wrap hidden><label for="ve-time">Heure de valeur (UTC)</label><input id="ve-time" name="time" type="time" step="3600" data-ve-time>
                <p class="hint" data-ve-fine hidden>Minute ou seconde : à utiliser uniquement si la source fournit réellement des données à cette fréquence (flux de marché, dépositaire).</p></div>
              <div class="adm-ve-values">
                <div><span class="pf-lab">Valeur précédente</span><b data-ve-prev><%= usd(s.active[0].current_value) %></b></div>
                <div><label for="ve-value">Nouvelle valeur ($)</label><input id="ve-value" name="value" type="text" inputmode="decimal" required data-ve-value></div>
                <div><span class="pf-lab">Variation</span><b data-ve-diff>—</b></div>
              </div>
              <div><label for="ve-src">Source / référence *</label><input id="ve-src" name="note" type="text" required maxlength="400" placeholder="Relevé du gestionnaire, rapport, expertise…"></div>
              <div><label for="ve-com">Commentaire</label><input id="ve-com" name="comment" type="text" maxlength="300"></div>
              <p class="alert alert-error small" data-ve-error hidden></p>
              <div class="adm-ve-actions">
                <button class="btn btn-ghost btn-sm" type="button" data-ve-preview>Aperçu de l'évolution</button>
                <button class="btn btn-ghost btn-sm" type="submit" name="publish" value="0">Enregistrer en brouillon</button>
                <button class="btn btn-gold btn-sm" type="submit" name="publish" value="1" data-confirm-publish>Publier pour le client</button>
              </div>
              <p class="hint mb-0">L'aperçu n'enregistre rien. Un brouillon n'est pas visible du client. Une valorisation publiée apparaît aussitôt dans son tableau de bord et reste inscrite au journal d'audit.</p>
            </form>
            <% } %>
          </div>
        </div>

        <% if (drafts.length) { %>
        <div class="pf-card">
          <div class="pf-card-head"><h2>Brouillons en attente de publication</h2></div>
          <div class="pf-table"><table>
            <thead><tr><th>Date de valeur</th><th>Position</th><th class="num">Valeur</th><th>Source</th><th></th></tr></thead>
            <tbody><% drafts.forEach(function (v) { %>
              <tr><td><%= fmtDate(v.effective_at, true) %></td><td>#<%= v.investment_id %> · <%= v.title %></td><td class="num"><b><%= usd(v.value_cents) %></b></td><td><small><%= v.note %></small></td>
                <td><div class="actions"><form method="post" action="/admin/valuations/<%= v.id %>/publish" data-confirm="Publier cette valorisation pour le client ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-gold btn-sm" type="submit">Publier</button></form><form method="post" action="/admin/valuations/<%= v.id %>/discard" data-confirm="Abandonner ce brouillon ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm" type="submit">Abandonner</button></form></div></td></tr>
            <% }) %></tbody>
          </table></div>
        </div>
        <% } %>

        <div class="pf-card">
          <div class="pf-card-head"><h2>Chronologie du portefeuille</h2></div>
          <% if (!timeline.length) { %><p class="pf-none">Aucune écriture.</p><% } else { %>
          <ol class="adm-timeline">
            <% timeline.forEach(function (p) { %>
              <li class="<%= p.change > 0 ? 'up' : p.change < 0 ? 'down' : '' %>"><time><%= fmtDate(new Date(p.t).toISOString(), true) %></time><b><%= usd(p.value) %></b><span class="<%= p.change >= 0 ? 'pos' : 'neg' %>"><%= signed(p.change) %></span><small><%= pct(p.perf) %></small></li>
            <% }) %>
          </ol>
          <% } %>
        </div>
      </div>
    </section>

    <section class="panel" id="deposit">
      <div class="panel-head"><h2>Créditer un dépôt reçu et vérifié</h2></div>
      <form class="card form" method="post" action="/admin/users/<%= u.id %>/deposits/credit" enctype="multipart/form-data" data-confirm="Créditer ce dépôt sur le compte du client ? L'opération sera inscrite au journal d'audit.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="small muted mb-0">À utiliser uniquement lorsque les fonds ont été effectivement reçus et contrôlés (relevé bancaire ou confirmation du prestataire). Le montant apparaît aussitôt dans le compte du client et dans son historique.</p>
        <div class="form-row form-row-3">
          <div><label for="cr-amount">Montant reçu *</label><input id="cr-amount" name="amount" type="text" inputmode="decimal" required></div>
          <div><label for="cr-cur">Devise *</label><select id="cr-cur" name="currency" required><% currencies.forEach(function (c) { %><option value="<%= c %>"><%= c === 'XOF' ? 'FCFA' : c %></option><% }) %></select></div>
          <div><label for="cr-method">Moyen de paiement *</label><select id="cr-method" name="method" required><option value="bank_transfer">Virement bancaire</option><option value="card">Carte</option><option value="cash">Espèces (reçu signé)</option><option value="other">Autre</option></select></div>
        </div>
        <div class="form-row form-row-3">
          <div><label for="cr-ref">Référence de l'opération *</label><input id="cr-ref" name="reference" type="text" required maxlength="120" placeholder="Référence du relevé ou du prestataire"></div>
          <div><label for="cr-date">Date de réception *</label><input id="cr-date" name="date" type="date" required max="<%= today %>" value="<%= today %>"></div>
          <div><label for="cr-file">Pièce justificative (PDF, image)</label><input id="cr-file" name="file" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp"></div>
        </div>
        <div><label for="cr-note">Note interne</label><input id="cr-note" name="note" type="text" maxlength="500"></div>
        <p class="hint">Les comptes sont tenus en dollars : un montant saisi dans une autre devise est converti au taux enregistré dans Paramètres, et le montant d'origine est conservé dans la note. La pièce jointe reste interne (non visible du client).</p>
        <label class="check"><input type="checkbox" name="verified" required> Je confirme avoir vérifié la réception effective de ces fonds sur le compte officiel.</label>
        <div><button class="btn btn-gold" type="submit">Confirmer le dépôt</button></div>
      </form>
      <div class="table-wrap mt-2"><table>
        <thead><tr><th>Date</th><th>Référence</th><th>Référence externe</th><th class="num">Montant</th><th>Statut</th></tr></thead>
        <tbody>
          <% var deps = txs.filter(function (x) { return x.type === 'deposit'; }); if (!deps.length) { %><tr><td colspan="5" class="empty">Aucun dépôt.</td></tr><% } %>
          <% deps.forEach(function (x) { %><tr><td class="small"><%= fmtDate(x.processed_at || x.created_at, true) %></td><td class="mono"><%= x.reference %></td><td class="small"><%= x.external_ref || '—' %><% if (x.admin_note) { %><div class="muted"><%= x.admin_note %></div><% } %></td><td class="num"><%= usd(x.amount_cents) %></td><td><%- include('../partials/tx-status', { status: x.status }) %></td></tr><% }) %>
        </tbody>
      </table></div>
    </section>

    <section class="panel" id="withdrawals">
      <div class="panel-head"><h2>Retraits</h2><a class="small" href="/admin/withdrawals">Gestion des retraits →</a></div>
      <%- include('_tx-admin-table', { rows: txs.filter(function (x) { return x.type === 'withdrawal'; }).map(function (x) { return Object.assign({}, x, { full_name: u.full_name, email: u.email, kyc_status: u.kyc_status }); }) }) %>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Enregistrer un dépôt annoncé (en attente de vérification)</h2></div>
      <form class="card form" method="post" action="/admin/users/<%= u.id %>/deposits">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="small muted mb-0">À utiliser lorsqu'un virement du client a été reçu selon les instructions que vous lui avez communiquées. Le dépôt est créé « en attente » ; il n'est crédité qu'après confirmation dans « Dépôts & retraits », avec la référence du relevé bancaire.</p>
        <div class="form-row form-row-2">
          <div><label for="dep-amount">Montant reçu ($)</label><input id="dep-amount" name="amount" type="text" inputmode="decimal" required></div>
          <div class="actions" style="align-items:end"><button class="btn btn-navy" type="submit">Enregistrer le dépôt en attente</button></div>
        </div>
      </form>
    </section>

    <section class="panel" id="invest">
      <div class="panel-head"><h2>Investissements</h2></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Projet</th><th class="num">Montant</th><th>Période</th><th class="num">Dernière valeur</th><th>Statut</th><th>Actions</th></tr></thead>
          <tbody>
          <% if (!s.items.length) { %><tr><td colspan="6" class="empty">Aucun investissement.</td></tr><% } %>
          <% s.items.forEach(function (i) { %>
            <tr>
              <td><strong><%= i.title %></strong><div class="small muted">#<%= i.id %></div></td>
              <td class="num"><%= usd(i.amount_cents) %></td>
              <td class="small"><%= fmtDate(i.start_date) %> → <%= fmtDate(i.end_date) %></td>
              <td class="num"><%= usd(i.current_value) %><div class="small muted"><%= i.valued ? fmtDate(i.last_value_date) : 'non valorisé' %> · <%= pct(i.perf) %></div></td>
              <td><span class="chip <%= i.status === 'active' ? 'chip-success' : '' %>"><%= t('account.inv_' + i.status) %></span></td>
              <td style="min-width:260px">
                <% if (i.status === 'active') { %>
                <details class="box"><summary>Enregistrer une valorisation</summary>
                  <form class="form" method="post" action="/admin/investments/<%= i.id %>/valuations">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <div class="form-row form-row-2">
                      <div><label>Valeur ($)</label><input name="value" type="text" inputmode="decimal" required></div>
                      <div><label>Date</label><input name="date" type="date" required max="<%= today %>" value="<%= today %>"></div>
                    </div>
                    <div><label>Source / justification *</label><input name="note" type="text" required maxlength="500" placeholder="Rapport de gestion T3, expertise…"></div>
                    <button class="btn btn-navy btn-sm" type="submit">Enregistrer</button>
                  </form>
                </details>
                <details class="box"><summary>Clôturer à l'échéance</summary>
                  <form class="form" method="post" action="/admin/investments/<%= i.id %>/mature" data-confirm="Clôturer cet investissement et créditer le montant final ?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <div class="form-row form-row-2">
                      <div><label>Montant final versé ($)</label><input name="payout" type="text" inputmode="decimal" required></div>
                      <div><label>Date</label><input name="date" type="date" required max="<%= today %>" value="<%= today %>"></div>
                    </div>
                    <div><label>Justification *</label><input name="note" type="text" required maxlength="500"></div>
                    <label class="check"><input type="checkbox" name="verified" required> Je confirme le contrôle effectif des fonds disponibles pour ce versement.</label>
                    <button class="btn btn-gold btn-sm" type="submit">Clôturer et créditer</button>
                  </form>
                </details>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>

      <div class="card mt-2">
        <h3 style="font-size:1rem">Enregistrer un nouvel investissement</h3>
        <% if (u.kyc_status !== 'approved') { %>
          <p class="alert alert-warning small mb-0">L'identité de l'investisseur doit être vérifiée avant tout investissement.</p>
        <% } else if (!openProjects.length) { %>
          <p class="muted small mb-0">Aucun projet ouvert.</p>
        <% } else { %>
          <p class="small muted">Le montant est débité du solde disponible de l'investisseur (dépôts confirmés). Fiches de démonstration exclues.</p>
          <form class="form" method="post" action="/admin/users/<%= u.id %>/investments" data-confirm="Enregistrer cet investissement ?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <div class="form-row form-row-2">
              <div><label>Projet</label><select name="project_id" required><% openProjects.forEach(function (p) { %><option value="<%= p.id %>"><%= p.title %></option><% }) %></select></div>
              <div><label>Montant ($) — disponible : <%= usd(s.available) %></label><input name="amount" type="text" inputmode="decimal" required></div>
            </div>
            <div class="form-row form-row-2">
              <div><label>Date de début</label><input name="start_date" type="date" required value="<%= today %>"></div>
              <div><label>Échéance prévue</label><input name="end_date" type="date" required></div>
            </div>
            <div><button class="btn btn-gold btn-sm" type="submit">Enregistrer l'investissement</button></div>
          </form>
        <% } %>
      </div>
    </section>

    <section class="panel" id="valuations">
      <div class="panel-head"><h2>Valorisation du portefeuille / performance</h2></div>
      <p class="small muted">Chaque valorisation enregistrée ici alimente automatiquement le graphique du client. La performance est calculée par rapport au montant investi.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Date de valeur</th><th>Investissement</th><th class="num">Valeur précédente</th><th class="num">Valeur actuelle</th><th class="num">Variation</th><th class="num">Performance</th><th>Source / référence</th><th>Correction</th></tr></thead>
        <tbody>
          <% if (!history.length) { %><tr><td colspan="8" class="empty">Aucune valorisation.</td></tr><% } %>
          <% history.forEach(function (v, k) { var older = history.slice(k + 1).filter(function (o) { return o.investment_id === v.investment_id; })[0]; var prev = older ? Number(older.value_cents) : Number(v.amount_cents); var diff = Number(v.value_cents) - prev; %><tr><td><%= fmtDate(v.effective_at, true) %><% if (Number(v.published) === 0) { %> <span class="chip chip-warning">Brouillon</span><% } %><div class="small muted">saisie le <%= fmtDate(v.created_at, true) %></div></td><td><%= v.title %><div class="small muted">#<%= v.investment_id %></div></td><td class="num"><%= usd(prev) %></td><td class="num"><strong><%= usd(v.value_cents) %></strong></td><td class="num <%= diff >= 0 ? 'pos' : 'neg' %>"><%= (diff > 0 ? '+' : diff < 0 ? '−' : '') + usd(Math.abs(diff)) %></td><td class="num <%= v.perf >= 0 ? 'pos' : 'neg' %>"><%= pct(v.perf) %></td><td class="small"><%= v.note %></td><td style="min-width:240px"><details class="box"><summary>Corriger</summary><form class="form" method="post" action="/admin/valuations/<%= v.id %>/correct" data-confirm="Corriger cette valorisation ? L'ancienne valeur restera au journal d'audit."><input type="hidden" name="_csrf" value="<%= csrf %>"><div><label>Nouvelle valeur ($)</label><input name="value" type="text" inputmode="decimal" required></div><div><label>Motif / pièce justificative *</label><input name="reason" type="text" required maxlength="500"></div><button class="btn btn-navy btn-sm" type="submit">Corriger</button></form></details></td></tr><% }) %>
        </tbody>
      </table></div>
    </section>

    <section class="panel">
      <details class="box"><summary>Importer plusieurs valorisations</summary>
        <form class="form" method="post" action="/admin/users/<%= u.id %>/valuations/import">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div><label for="imp-lines">Une ligne par valorisation : n° d'investissement ; date (AAAA-MM-JJ) ; valeur en $ ; source</label>
            <textarea id="imp-lines" name="lines" rows="4" required placeholder="12 ; 2026-09-30 ; 10450.00 ; Rapport de gestion T3 2026"></textarea>
            <p class="hint">Le numéro d'investissement figure sous le nom du projet (#…). Si une seule ligne est invalide, rien n'est enregistré.</p></div>
          <button class="btn btn-navy btn-sm" type="submit">Importer</button>
        </form>
      </details>
    </section>

    <section class="panel" id="entries">
      <div class="panel-head"><h2>Enregistrer un revenu versé ou des frais prélevés</h2></div>
      <div class="card">
        <p class="small muted">À utiliser uniquement pour une opération réellement effectuée, pièce à l'appui. L'écriture apparaît dans l'historique du client et au journal d'audit.</p>
        <form class="form" method="post" action="/admin/users/<%= u.id %>/entries" data-confirm="Enregistrer cette écriture sur le compte du client ?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="form-row form-row-3">
            <div><label for="en-type">Type</label><select id="en-type" name="type" required><option value="payout">Revenu / distribution versé au client</option><option value="fee">Frais prélevés</option></select></div>
            <div><label for="en-amount">Montant ($)</label><input id="en-amount" name="amount" type="text" inputmode="decimal" required></div>
            <div><label for="en-inv">Investissement concerné</label><select id="en-inv" name="investment_id"><option value="">— aucun —</option><% s.active.forEach(function (i) { %><option value="<%= i.id %>">#<%= i.id %> · <%= i.title %></option><% }) %></select></div>
          </div>
          <div class="form-row form-row-2">
            <div><label for="en-proof">Référence de la pièce (relevé, virement…) *</label><input id="en-proof" name="proof" type="text" required maxlength="120"></div>
            <div><label for="en-reason">Motif *</label><input id="en-reason" name="reason" type="text" required maxlength="500"></div>
          </div>
          <label class="check"><input type="checkbox" name="verified" required> Je confirme avoir contrôlé que cette opération a réellement eu lieu.</label>
          <div><button class="btn btn-navy btn-sm" type="submit">Enregistrer l'écriture</button></div>
        </form>
      </div>
    </section>

    <section class="panel" id="notify">
      <div class="panel-head"><h2>Envoyer une notification au client</h2></div>
      <div class="card">
        <form class="form" method="post" action="/admin/users/<%= u.id %>/notify">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div><label for="nt-msg">Message (affiché dans son espace et envoyé par e-mail)</label><textarea id="nt-msg" name="message" rows="3" required maxlength="600"></textarea></div>
          <div><button class="btn btn-navy btn-sm" type="submit">Envoyer</button></div>
        </form>
      </div>
    </section>

    <section class="panel" id="transactions">
      <div class="panel-head"><h2>Transactions</h2><a class="small" href="/admin/transactions">Toutes les transactions →</a></div>
      <%- include('_tx-admin-table', { rows: txs.map(function (x) { return Object.assign({}, x, { full_name: u.full_name, email: u.email, kyc_status: u.kyc_status }); }) }) %>
    </section>

    <section class="panel" id="docs">
      <div class="panel-head"><h2>Documents contractuels et relevés</h2></div>
      <div class="card">
        <% if (docs.length) { %><ul class="doc-list"><% docs.forEach(function (d) { %><li><span>📄 <strong><%= d.title %></strong> <span class="small muted">— <%= t('docs.' + d.category) %> · <%= fmtDate(d.created_at) %></span></span><a class="btn btn-ghost btn-sm" href="/admin/users/<%= u.id %>/documents/<%= d.id %>">Télécharger</a></li><% }) %></ul><% } else { %><p class="muted">Aucun document.</p><% } %>
        <form class="form mt-2" method="post" action="/admin/users/<%= u.id %>/documents" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="form-row form-row-3">
            <div><label>Titre *</label><input name="title" type="text" required maxlength="200"></div>
            <div><label>Catégorie</label><select name="category"><option value="contract">Contrat</option><option value="statement">Relevé</option><option value="other">Autre</option></select></div>
            <div><label>Fichier *</label><input name="file" type="file" required accept=".pdf,.jpg,.jpeg,.png,.webp"></div>
          </div>
          <div><button class="btn btn-navy btn-sm" type="submit">Ajouter et notifier</button></div>
        </form>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Notifications envoyées au client</h2></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Message</th><th>Lue</th></tr></thead>
        <tbody>
          <% if (!notifs.length) { %><tr><td colspan="3" class="empty">Aucune notification.</td></tr><% } %>
          <% notifs.forEach(function (n) { %><tr><td class="small" style="white-space:nowrap"><%= fmtDate(n.created_at, true) %></td><td class="small"><%= n.message %></td><td class="small"><%= n.read_at ? 'Oui' : 'Non' %></td></tr><% }) %>
        </tbody>
      </table></div>
    </section>

    <section class="panel" id="activity">
      <div class="panel-head"><h2>Journal d'activité de ce compte</h2><a class="small" href="/admin/audit">Journal complet →</a></div>
      <%- include('_audit-table', { rows: audits }) %>
    </section>

    <section class="panel">
      <div class="panel-head"><h2>Dernières tentatives de connexion</h2></div>
      <%- include('_logins-table', { rows: logins }) %>
    </section>
  </div>
</div>
<script src="/static/js/portfolio.js?v=<%= assetV %>" defer></script>
<script src="/static/js/admin-valuation.js?v=<%= assetV %>" defer></script>
<%- include('../partials/bottom') %>
