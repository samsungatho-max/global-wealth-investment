<%- include('../partials/top', { bodyClass: 'admin-body' }) %>
<div class="container dash">
  <%- include('../partials/admin-nav') %>
  <div>
    <div class="dash-head"><h1>Actualités et rapports</h1>
      <div class="actions">
        <a class="btn btn-ghost btn-sm" href="/admin/news-watch">Veille des sources<% if (pending) { %> <span class="badge-dot"><%= pending %></span><% } %></a>
        <a class="btn btn-gold btn-sm" href="/admin/news/new">+ Nouvelle publication</a>
      </div>
    </div>
    <p class="alert alert-info small">Règle éditoriale : chaque publication doit citer une source officielle consultable, donner ses chiffres avec leur période et rester une synthèse originale. Ne publiez jamais un chiffre que vous n'avez pas lu dans la source.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Titre</th><th>Catégories</th><th>Source(s)</th><th>État</th><th>Date</th><th></th></tr></thead>
        <tbody>
        <% if (!rows.length) { %><tr><td colspan="6" class="empty">Aucune publication.</td></tr><% } %>
        <% rows.forEach(function (n) { var state = !n.published ? ['Brouillon', ''] : (n.visible ? ['En ligne', 'chip-success'] : ['Planifié', 'chip-warning']); %>
          <tr>
            <td><strong><%= n.tr.title %></strong><% if (n.featured) { %> <span class="chip chip-gold">À la une</span><% } %><div class="small muted"><%= n.kind === 'report' ? 'Rapport' : 'Actualité' %></div></td>
            <td class="small"><%= t('news.region.' + n.region) %><br><%= t('news.sector.' + n.sector) %></td>
            <td class="small"><% if (!n.sourceList.length) { %><span class="chip chip-danger">Aucune source</span><% } %><% n.sourceList.forEach(function (s) { %><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.name.split(' — ')[0] %> ↗</a><br><% }) %></td>
            <td><span class="chip <%= state[1] %>"><%= state[0] %></span></td>
            <td class="small"><%= fmtDate(n.publish_at || n.published_at || n.created_at, true) %></td>
            <td><div class="actions">
              <a class="btn btn-ghost btn-sm" href="/admin/news/<%= n.id %>/edit">Modifier</a>
              <% if (n.visible) { %><a class="btn btn-ghost btn-sm" href="/news/<%= n.slug %>" target="_blank">Voir ↗</a><% } %>
              <form method="post" action="/admin/news/<%= n.id %>/delete" data-confirm="Supprimer définitivement cette publication ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm" type="submit">Supprimer</button></form>
            </div></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
