<%- include('../partials/top', { bodyClass: 'admin-body' }) %>
<div class="container dash">
  <%- include('../partials/admin-nav') %>
  <div>
    <div class="dash-head"><h1>Journal d'audit</h1></div>
    <p class="alert alert-info small">Journal en ajout seul : la base de données refuse toute modification ou suppression de ces entrées (déclencheurs SQL).</p>
    <form class="flex mb-2" method="get" action="/admin/audit">
      <input type="search" name="q" value="<%= q %>" placeholder="Action, administrateur, client, référence, motif…" style="max-width:360px">
      <label class="check" style="margin:0"><input type="checkbox" name="fin" value="1" <%= fin ? 'checked' : '' %>> Opérations financières uniquement</label>
      <button class="btn btn-navy btn-sm" type="submit">Rechercher</button>
    </form>
    <%- include('_audit-table', { rows: rows }) %>
    <div class="flex mt-2">
      <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="/admin/audit?page=<%= page - 1 %>&q=<%= encodeURIComponent(q) %><%= fin ? '&fin=1' : '' %>">← Plus récent</a><% } %>
      <% if (rows.length === 100) { %><a class="btn btn-ghost btn-sm" href="/admin/audit?page=<%= page + 1 %>&q=<%= encodeURIComponent(q) %><%= fin ? '&fin=1' : '' %>">Plus ancien →</a><% } %>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
