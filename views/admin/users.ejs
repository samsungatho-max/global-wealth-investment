<%- include('../partials/top', { bodyClass: 'admin-body' }) %>
<div class="container dash">
  <%- include('../partials/admin-nav') %>
  <div class="adm">
    <div class="dash-head"><div><p class="pf-kicker">Clients</p><h1>Comptes clients</h1></div><span class="pf-dim small"><%= rows.length %> résultat(s)</span></div>
    <form class="adm-filters" method="get" action="/admin/users">
      <div class="adm-search"><%- include('../partials/icon', { name: 'search', size: 17 }) %><input type="search" name="q" value="<%= q %>" placeholder="Nom, e-mail, n° de compte (GC-000123), référence, pays…" aria-label="Rechercher"></div>
      <select name="country" aria-label="Pays"><option value="">Tous les pays</option><% countries.forEach(function (c) { %><option value="<%= c %>" <%= country === c ? 'selected' : '' %>><%= countryName(c) %></option><% }) %></select>
      <select name="status" aria-label="Statut"><option value="">Tous les statuts</option><option value="active" <%= status === 'active' ? 'selected' : '' %>>Actif</option><option value="suspended" <%= status === 'suspended' ? 'selected' : '' %>>Suspendu</option></select>
      <select name="kyc" aria-label="Identité"><option value="">Identité : toutes</option><% ['none','pending','approved','rejected'].forEach(function (k) { %><option value="<%= k %>" <%= kyc === k ? 'selected' : '' %>><%= t('kyc.' + k) %></option><% }) %></select>
      <button class="btn btn-navy btn-sm" type="submit">Filtrer</button>
      <% if (q || kyc || status || country) { %><a class="btn btn-ghost btn-sm" href="/admin/users">Effacer</a><% } %>
    </form>
    <div class="pf-card"><div class="pf-table">
      <table>
        <thead><tr><th>Client</th><th>N° de compte</th><th>Pays</th><th>Identité</th><th class="num">Solde</th><th>Inscription</th><th>Statut</th></tr></thead>
        <tbody>
        <% if (!rows.length) { %><tr><td colspan="7" class="pf-dim">Aucun résultat.</td></tr><% } %>
        <% rows.forEach(function (u) { %>
          <tr>
            <td><a href="/admin/users/<%= u.id %>"><b><%= u.full_name %></b></a><% if (u.role === 'admin') { %> <span class="chip chip-navy">admin</span><% } %><small><%= u.email %><% if (!u.email_verified_at) { %> · e-mail non vérifié<% } %></small></td>
            <td class="mono"><%= acctNo(u.id) %></td>
            <td><%= countryName(u.country) %></td>
            <td><span class="chip <%= { approved: 'chip-success', pending: 'chip-warning', rejected: 'chip-danger' }[u.kyc_status] || '' %>"><%= t('kyc.' + u.kyc_status) %></span></td>
            <td class="num"><b><%= usd(u.cash) %></b></td>
            <td><%= fmtDate(u.created_at) %></td>
            <td><span class="chip <%= u.status === 'active' ? 'chip-success' : 'chip-danger' %>"><%= u.status === 'active' ? 'Actif' : 'Suspendu' %></span></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div></div>
  </div>
</div>
<%- include('../partials/bottom') %>
