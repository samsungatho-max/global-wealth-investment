<%- include('../partials/top', { bodyClass: 'admin-body' }) %>
<div class="container dash">
  <%- include('../partials/admin-nav') %>
  <div>
    <div class="dash-head"><h1>Messages clients</h1></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Expéditeur</th><th>Objet</th><th>Statut</th><th></th></tr></thead>
        <tbody>
        <% if (!rows.length) { %><tr><td colspan="5" class="empty">Aucun message.</td></tr><% } %>
        <% rows.forEach(function (m) { %>
          <tr>
            <td class="small"><%= fmtDate(m.created_at, true) %></td>
            <td><strong><%= m.name %></strong><div class="small muted"><%= m.email %><% if (m.user_id) { %> · investisseur<% } %></div></td>
            <td><%= m.subject %></td>
            <td><span class="chip <%= { new: 'chip-warning', read: 'chip-gold', answered: 'chip-success', closed: '' }[m.status] %>"><%= { new: 'Nouveau', read: 'Lu', answered: 'Répondu', closed: 'Clos' }[m.status] %></span></td>
            <td><a class="btn btn-ghost btn-sm" href="/admin/messages/<%= m.id %>">Ouvrir</a></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
