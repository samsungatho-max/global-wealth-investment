<%- include('../partials/top') %>
<%- include("../partials/page-hero", { heroPhoto: "poignee-main", heroEyebrow: t("nav.contact"), heroTitle: t("site.contact_title"), heroText: t("site.contact_lead") }) %>
<% var bad = function (f) { return errors.indexOf(f) !== -1; }; var inv = function (f) { return bad(f) ? 'aria-invalid="true"' : ''; }; %>

<section class="section section-gray contact-main" id="formulaire">
  <div class="container contact-layout">
    <div class="card contact-card">
      <h2 class="contact-card-title"><%= t('site.contact_form_t') %></h2>
      <p class="hint"><%= t('req.required_note') %></p>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
      <form class="form req-form" method="post" action="/contact#formulaire">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="hp-field" aria-hidden="true"><label for="c-fax">Fax</label><input id="c-fax" name="fax_number" type="text" tabindex="-1" autocomplete="off"></div>
        <div>
          <label for="c-motive"><%= t('req.motive') %> *</label>
          <select id="c-motive" name="motive" required <%- inv('motive') %>>
            <% motives.forEach(function (m) { %><option value="<%= m %>" <%= values.motive === m ? 'selected' : '' %>><%= t('req.m_' + m) %></option><% }) %>
          </select>
        </div>
        <div class="form-row form-row-2">
          <div><label for="c-name"><%= t('req.full_name') %> *</label><input id="c-name" name="full_name" type="text" required maxlength="120" autocomplete="name" value="<%= values.full_name || '' %>" <%- inv('full_name') %>></div>
          <div><label for="c-email"><%= t('req.email') %> *</label><input id="c-email" name="email" type="email" required maxlength="200" autocomplete="email" value="<%= values.email || '' %>" <%- inv('email') %>></div>
        </div>
        <div><label for="c-phone"><%= t('req.phone') %> <span class="hint">(<%= t('common.optional') %>)</span></label><input id="c-phone" name="phone" type="tel" maxlength="30" autocomplete="tel" value="<%= values.phone || '' %>" <%- inv('phone') %>><p class="hint"><%= t('req.phone_hint') %></p></div>
        <div><label for="c-msg"><%= t('site.message') %> *</label><textarea id="c-msg" name="description" required maxlength="6000" rows="7" <%- inv('description') %>><%= values.description || '' %></textarea></div>
        <label class="check certify <%= bad('certify') ? 'is-invalid' : '' %>"><input type="checkbox" name="certify" required <%= values.certify ? 'checked' : '' %>><span><%= t('site.consent') %> * <a href="/page/privacy"><%= t('footer.privacy') %></a></span></label>
        <div class="req-submit">
          <button class="btn btn-emerald btn-lg" type="submit"><%= t('site.send') %> <%- include('../partials/icon', { name: 'arrow', size: 16 }) %></button>
          <p class="hint mb-0"><%- include('../partials/icon', { name: 'lock', size: 14 }) %> <%= t('req.privacy') %></p>
        </div>
      </form>
    </div>

    <aside class="contact-side">
      <div class="card contact-steps">
        <h3><%= t('site.contact_project_t') %></h3>
        <p class="small muted"><%= t('site.contact_project_p') %></p>
        <a class="btn btn-navy btn-block" href="/submit-project"><%= t('site.cta_submit') %> <%- include('../partials/icon', { name: 'arrow', size: 16 }) %></a>
      </div>
      <% if (company.legal_name || company.address || company.email || company.phone) { %>
      <div class="card card-muted">
        <h3><%= t('site.coords') %></h3>
        <dl class="contact-direct">
          <% if (company.legal_name || company.address) { %><div><dt><%- include('../partials/icon', { name: 'building', size: 18 }) %></dt><dd><%= company.legal_name %><% if (company.legal_name && company.address) { %><br><% } %><span class="muted"><%= company.address %></span></dd></div><% } %>
          <% if (company.email) { %><div><dt><%- include('../partials/icon', { name: 'file', size: 18 }) %></dt><dd><a href="mailto:<%= company.email %>"><%= company.email %></a></dd></div><% } %>
          <% if (company.phone) { %><div><dt><%- include('../partials/icon', { name: 'user', size: 18 }) %></dt><dd><%= company.phone %></dd></div><% } %>
          <% if (company.hours) { %><div><dt><%- include('../partials/icon', { name: 'clock', size: 18 }) %></dt><dd><%= company.hours %></dd></div><% } %>
        </dl>
      </div>
      <% } %>
    </aside>
  </div>
</section>
<%- include('../partials/bottom') %>
