<%- include('../partials/top') %>
<% var pagePhotos = { about: "reunion", strategies: "graphiques", sectors: "eolien", risks: "chantier", faq: "poignee-main" }; %><%- include("../partials/page-hero", { heroPhoto: pagePhotos[slug] || "immeuble-2", heroTitle: tr.title }) %>
<section class="section">
  <div class="container">
    <div class="prose">
      <%- bodyHtml %>
      <% if (slug === 'legal') { %>
        <%
          var cLabels = {"fr":["Raison sociale","Forme juridique","Immatriculation","Siège social","E-mail","Téléphone","Directeur de la publication","Hébergeur"],"en":["Company name","Legal form","Registration","Head office","Email","Phone","Publication director","Host"],"es":["Razón social","Forma jurídica","Registro","Sede social","Correo electrónico","Teléfono","Director de la publicación","Alojamiento"],"de":["Firma","Rechtsform","Registernummer","Sitz","E-Mail","Telefon","Verantwortlich für den Inhalt","Hosting-Anbieter"]};
          var cRows = ['legal_name', 'legal_form', 'registration', 'address', 'email', 'phone', 'director', 'host'].map(function (k, i) { return [(cLabels[lang] || cLabels.fr)[i], company[k], k]; }).filter(function (r) { return r[1]; });
          if (company.regulatory_status) cRows.push([t('footer.regulatory'), company.regulatory_status, 'regulatory_status']);
        %>
        <% if (cRows.length) { %>
        <h2><%= t('contact.company') %></h2>
        <dl class="kv card">
          <% cRows.forEach(function (r) { %><dt><%= r[0] %></dt><dd><% if (r[2] === 'email') { %><a href="mailto:<%= r[1] %>"><%= r[1] %></a><% } else { %><%= r[1] %><% } %></dd><% }) %>
        </dl>
        <% } %>
      <% } %>
      <% if (slug === 'risks') { %>
        <h2><%= t('risk.label') %></h2>
        <div class="table-wrap"><table>
          <% [1,2,3,4,5].forEach(function (r) { %>
            <tr><td style="white-space:nowrap"><span class="risk-meter r<%= r %>"><% for (var i = 1; i <= 5; i++) { %><i class="<%= i <= r ? 'on' : '' %>"></i><% } %></span> <strong><%= r %> — <%= t('risk.' + r) %></strong></td><td><%= t('risk.d' + r) %></td></tr>
          <% }) %>
        </table></div>
      <% } %>
      <p class="small muted mt-3"><%= fmtDate(updated) %></p>
    </div>
  </div>
</section>
<%- include('../partials/bottom') %>
