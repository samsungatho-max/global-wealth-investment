<%- include('../partials/top') %>
<% var np = photo(n.photo); var src0 = n.sourceList[0]; %>
<section class="page-hero has-photo">
  <% if (n.image_path) { %>
    <img class="page-hero-bg" src="/media/<%= n.image_path %>" alt="" fetchpriority="high">
  <% } else { %>
    <img class="page-hero-bg" src="<%= np.large %>" srcset="<%= np.small %> 800w, <%= np.large %> 1600w" sizes="100vw" alt="" fetchpriority="high" decoding="async">
  <% } %>
  <div class="container page-hero-inner">
    <div class="breadcrumb"><a href="/news">← <%= t('news.back') %></a></div>
    <div class="flex" style="margin-bottom:12px">
      <span class="chip chip-gold"><%= t('news.' + n.kind) %></span>
      <span class="chip chip-navy"><%= t('news.region.' + n.region) %></span>
      <span class="chip chip-navy"><%= t('news.sector.' + n.sector) %></span>
      <span class="chip chip-navy"><%= t('news.type.' + n.inv_type) %></span>
    </div>
    <h1><%= n.tr.title %></h1>
    <p><%= n.tr.summary %></p>
  </div>
</section>

<div class="container">
  <div class="article-layout">
    <article>
      <p class="article-meta">
        <time datetime="<%= String(n.date).slice(0, 10) %>"><%= t('news.published', { date: fmtDate(n.date) }) %></time>
        <% if (src0) { %> · <%= t('news.source') %> : <a href="<%= src0.url %>" target="_blank" rel="noopener noreferrer"><%= src0.name %></a><% if (src0.date) { %> (<%= t('news.source_published', { date: fmtDate(src0.date) }) %>)<% } %><% } %>
      </p>

      <div class="prose"><%- bodyHtml %></div>

      <% if (n.chart.length >= 2) { %>
        <%- include('../partials/bar-chart', { items: n.chart, chartTitle: n.tr.chart_title, unit: n.tr.chart_unit, sourceName: src0 ? src0.name : '' }) %>
      <% } %>

      <% if (n.figures.length) { %>
        <h2 class="mt-4"><%= t('news.figures') %></h2>
        <div class="table-wrap">
          <table class="figures">
            <thead><tr><th><%= t('news.indicator') %></th><th class="num"><%= t('news.value') %></th><th><%= t('news.period') %></th></tr></thead>
            <tbody><% n.figures.forEach(function (fg) { %><tr><td><%= fg.label %></td><td class="num"><strong><%= fg.value %></strong></td><td class="small"><%= fg.period %></td></tr><% }) %></tbody>
          </table>
        </div>
      <% } %>

      <% if (n.tr.risks) { %>
        <h2 class="mt-4"><%= t('news.risks') %></h2>
        <div class="alert alert-warning"><%= n.tr.risks %></div>
      <% } %>

      <h2 class="mt-4"><%= n.sourceList.length > 1 ? t('news.sources') : t('news.source') %></h2>
      <ul class="source-list">
        <% n.sourceList.forEach(function (s) { %>
          <li><strong><%= s.name %></strong><% if (s.date) { %> — <%= t('news.source_published', { date: fmtDate(s.date) }) %><% } %><br>
            <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= t('news.read_source') %> ↗</a></li>
        <% }) %>
        <% if (n.report_url) { %><li><a class="btn btn-ghost btn-sm" href="<%= n.report_url %>" target="_blank" rel="noopener noreferrer">📄 <%= t('news.original_report') %> ↗</a></li><% } %>
        <% if (n.file_path) { %><li><a class="btn btn-gold btn-sm" href="/news/<%= n.slug %>/file">📄 <%= t('news.download') %></a></li><% } %>
      </ul>
      <p class="small muted"><%= t('news.disclaimer') %></p>
    </article>

    <aside>
      <% if (n.takeaways.length) { %>
      <div class="takeaways takeaways-side sticky-card">
        <div class="takeaways-head"><span class="takeaways-icon"><%- include('../partials/icon', { name: 'check', size: 20 }) %></span><div><h2><%= t('news.takeaways_title') %></h2></div></div>
        <ul><% n.takeaways.forEach(function (k) { %><li><span><%= k %></span></li><% }) %></ul>
        <p class="small"><%= t('news.takeaways_note') %></p>
      </div>
      <% } %>
    </aside>
  </div>

  <% if (related.length) { %>
    <section class="section-sm">
      <div class="panel-head"><h2 class="mb-0"><%= t('news.related') %></h2></div>
      <div class="grid grid-3 mt-2"><% related.forEach(function (r) { %><%- include('../partials/news-card', { n: r, big: false }) %><% }) %></div>
    </section>
  <% } %>
</div>
<%- include('../partials/bottom') %>
