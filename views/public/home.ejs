<%- include('../partials/top', { bodyClass: 'home' }) %>
<link rel="stylesheet" href="/static/css/home.css?v=<%= assetV %>">
<% var hero = photo('hero'); var H = home; var arrow = function (n) { return include('../partials/icon', { name: 'arrow', size: n || 16 }); }; %>
<% var nfm = function (v, d) { return new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { maximumFractionDigits: d, minimumFractionDigits: d }).format(v); }; %>
<% var pct = function (r) { return (r > 0 ? '+' : r < 0 ? '−' : '') + nfm(Math.abs(r) * 100, 2) + ' %'; }; %>

<!-- ============ BANNIÈRE ============ -->
<section class="hero hero-photo hm-hero">
  <img class="hero-bg" src="<%= hero.large %>" srcset="<%= hero.small %> 800w, <%= hero.large %> 1600w" sizes="100vw" alt="<%= hero.alt %>" fetchpriority="high" decoding="async">
  <div class="hero-shade" aria-hidden="true"></div>
  <svg class="hm-hero-lines" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true">
    <path class="l1" d="M0 470 L120 452 L240 462 L360 418 L480 430 L600 372 L720 388 L840 322 L960 338 L1080 262 L1200 282 L1320 204 L1440 176"/>
    <path class="l2" d="M0 530 L160 512 L320 520 L480 478 L640 492 L800 440 L960 452 L1120 398 L1280 412 L1440 352"/>
  </svg>
  <div class="container hero-inner hm-hero-inner">
    <div class="hero-copy">
      <div class="eyebrow fade-up"><%= pick(H.hero.eyebrow) %></div>
      <h1 class="fade-up d1"><%= pick(H.hero.title) %></h1>
      <p class="hero-sub fade-up d2"><%= pick(H.hero.sub) %></p>
      <div class="hero-cta fade-up d3">
        <a class="btn btn-emerald btn-lg" href="/solutions"><%= pick(H.hero.cta1) %> <%- arrow(18) %></a>
        <a class="btn btn-glass btn-lg" href="/opportunities"><%= pick(H.hero.cta2) %></a>
        <a class="btn btn-line btn-lg" href="/submit-project"><%= pick(H.hero.cta3) %></a>
      </div>
    </div>
    <% if (marketTiles.length) { %>
    <aside class="hm-snap fade-up d4" aria-label="<%= pick(H.hero.snapshot) %>">
      <div class="hm-snap-head"><span><i></i><%= pick(H.hero.snapshot) %></span><a href="/markets"><%= t('site.mk_all') %> <%- arrow(13) %></a></div>
      <% marketTiles.slice(0, 3).forEach(function (s) { var g = spark(s.points.slice(-40), 110, 34, 3); var up = s.change == null || s.change >= 0; %>
      <a class="hm-snap-row" href="/markets/<%= s.cat %>">
        <span class="hm-snap-name"><b><%= s.name %></b><small><%= s.date %></small></span>
        <svg viewBox="0 0 110 34" aria-hidden="true" preserveAspectRatio="none"><path d="<%= g.d %>" class="hm-spark <%= up ? 'up' : 'down' %>"/></svg>
        <strong><%= nfm(s.value, s.digits) %><small><%= s.unit %></small></strong>
      </a>
      <% }) %>
      <p><%= pick(H.hero.snapshotNote) %></p>
    </aside>
    <% } %>
  </div>
</section>

<% if (marketTiles.length) { %>
<!-- ============ BARRE DE MARCHÉ ============ -->
<section class="hm-bar" aria-label="<%= t('site.mk_home_t') %>">
  <div class="container">
    <div class="hm-bar-track">
      <% marketTiles.forEach(function (s) { var up = s.change == null || s.change >= 0; %>
      <a class="hm-tick" href="/markets/<%= s.cat %>">
        <span class="hm-tick-name"><%= s.name %></span>
        <span class="hm-tick-val"><strong><%= nfm(s.value, s.digits) %></strong> <small><%= s.unit %></small><% if (s.changePct != null) { %><em class="<%= up ? 'up' : 'down' %>"><%= pct(s.changePct) %></em><% } else if (s.change != null) { %><em class="<%= up ? 'up' : 'down' %>"><%= (s.change > 0 ? '+' : s.change < 0 ? '−' : '') + nfm(Math.abs(s.change), 2) %> pt</em><% } %></span>
        <span class="hm-tick-date"><%= s.date %></span>
      </a>
      <% }) %>
    </div>
    <p class="hm-bar-note"><%= pick(H.bar.source) %> <a href="/markets"><%= pick(H.bar.all) %> →</a></p>
  </div>
</section>
<% } %>

<!-- ============ DOMAINES D'EXPERTISE ============ -->
<section class="section hm-exp">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow eyebrow-dark eyebrow-center reveal"><%= pick(H.expertise.eyebrow) %></div>
      <h2 class="reveal"><%= pick(H.expertise.title) %></h2>
      <p class="reveal"><%= pick(H.expertise.sub) %></p>
    </div>
    <div class="hm-exp-grid">
      <% H.expertise.cards.forEach(function (c, i) { var cp = photo(c.photo); %>
      <a class="hm-exp-card reveal" style="--d:<%= (i % 3) * 80 %>ms" href="<%= c.href %>">
        <span class="hm-exp-media"><img src="<%= cp.small %>" srcset="<%= cp.small %> 800w, <%= cp.large %> 1600w" sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" alt="<%= cp.alt %>" loading="lazy" decoding="async" width="800" height="600"></span>
        <span class="hm-exp-body">
          <span class="hm-exp-ico"><%- include('../partials/icon', { name: c.icon, size: 22 }) %></span>
          <h3><%= pick(c.title) %></h3>
          <p><%= pick(c.text) %></p>
          <span class="hm-link"><%= pick(H.expertise.more) %> <%- arrow(15) %></span>
        </span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============ MARCHÉS FINANCIERS ============ -->
<section class="hm-mk">
  <div class="container hm-mk-grid">
    <div class="hm-mk-copy">
      <div class="eyebrow reveal"><%= pick(H.markets.eyebrow) %></div>
      <h2 class="reveal"><%= pick(H.markets.title) %></h2>
      <p class="reveal"><%= pick(H.markets.sub) %></p>
      <ul class="hm-mk-cats reveal">
        <% nav.groups.filter(function (g) { return g.id === 'markets'; })[0].items.slice(1).forEach(function (i) { %>
          <li><a href="<%= i.href %>"><%- include('../partials/icon', { name: i.icon, size: 16 }) %><%= i.label %></a></li>
        <% }) %>
      </ul>
      <a class="btn btn-emerald btn-lg reveal" href="/markets"><%= pick(H.markets.cta) %> <%- arrow(18) %></a>
    </div>
    <div class="hm-mk-charts">
      <% if (!marketTiles.length) { %><p class="hm-mk-none reveal"><%= pick(H.markets.none) %></p><% } %>
      <% marketTiles.slice(0, 2).forEach(function (s, i) { var g = spark(s.points, 520, 170, 8); var up = s.periodPct == null ? (s.change == null || s.change >= 0) : s.periodPct >= 0; %>
      <a class="hm-chart reveal" style="--d:<%= i * 90 %>ms" href="/markets/<%= s.cat %>">
        <div class="hm-chart-head">
          <div><span><%= s.name %></span><strong><%= nfm(s.value, s.digits) %> <small><%= s.unit %></small></strong></div>
          <% if (s.periodPct != null) { %><em class="<%= up ? 'up' : 'down' %>" title="<%= pick(H.markets.over) %>"><%= pct(s.periodPct) %> <small><%= pick(H.markets.since) %> <%= s.periodFrom %></small></em><% } %>
        </div>
        <svg viewBox="0 0 520 170" preserveAspectRatio="none" aria-hidden="true">
          <defs><linearGradient id="hm-g<%= i %>" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="<%= up ? '#12a37a' : '#ff8a7a' %>" stop-opacity=".35"/><stop offset="1" stop-color="<%= up ? '#12a37a' : '#ff8a7a' %>" stop-opacity="0"/></linearGradient></defs>
          <path d="<%= g.d %> L512 170 L8 170 Z" fill="url(#hm-g<%= i %>)"/>
          <path d="<%= g.d %>" class="hm-spark big <%= up ? 'up' : 'down' %>"/>
        </svg>
        <div class="hm-chart-foot"><span><%= pick(H.markets.asOf) %> <%= s.date %></span><span><%= s.source.name.split(' — ')[0] %></span></div>
      </a>
      <% }) %>
      <% if (marketTiles.length > 2) { %>
      <div class="hm-stats reveal">
        <% marketTiles.slice(2).forEach(function (s) { %>
        <a href="/markets/<%= s.cat %>"><span><%= s.name %></span><strong><%= nfm(s.value, s.digits) %> <small><%= s.unit %></small></strong><small><%= s.date %></small></a>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ============ OPPORTUNITÉS ============ -->
<section class="section section-gray hm-opps">
  <div class="container">
    <div class="hm-head-row">
      <div>
        <div class="eyebrow eyebrow-dark reveal"><%= pick(H.opps.eyebrow) %></div>
        <h2 class="reveal"><%= t('opp.title') %></h2>
        <p class="reveal"><%= pick(H.opps.sub) %></p>
      </div>
      <a class="btn btn-ghost" href="/opportunities"><%= t('home.featured_all') %> <%- arrow(16) %></a>
    </div>
    <% if (projects.length) { %>
      <div class="grid grid-3 mt-3">
        <% projects.forEach(function (p, i) { %><div class="reveal" style="--d:<%= (i % 3) * 90 %>ms"><%- include('../partials/project-card', { p: p }) %></div><% }) %>
      </div>
      <% if (projects.some(function (p) { return p.is_demo; })) { %><p class="opp-demo-note small muted mt-3"><%- include('../partials/icon', { name: 'alert', size: 14 }) %><span><%= t('opp.demo_notice') %></span></p><% } %>
    <% } else { %>
      <%- include('../partials/opp-empty') %>
    <% } %>
  </div>
</section>

<!-- ============ NOTRE APPROCHE ============ -->
<section class="section hm-app">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow eyebrow-dark eyebrow-center reveal"><%= pick(H.approach.eyebrow) %></div>
      <h2 class="reveal"><%= pick(H.approach.title) %></h2>
      <p class="reveal"><%= pick(H.approach.sub) %></p>
    </div>
    <ol class="hm-steps">
      <% H.approach.steps.forEach(function (s, i) { %>
      <li class="reveal" style="--d:<%= i * 80 %>ms">
        <span class="hm-step-top"><span class="hm-step-ico"><%- include('../partials/icon', { name: s.icon, size: 22 }) %></span><span class="hm-step-n">0<%= i + 1 %></span></span>
        <h3><%= pick(s.title) %></h3>
        <p><%= pick(s.text) %></p>
      </li>
      <% }) %>
    </ol>
    <p class="text-center mt-3 reveal"><a class="btn btn-ghost" href="/company#approach"><%= pick(H.expertise.more) %> <%- arrow(16) %></a></p>
  </div>
</section>

<!-- ============ PORTÉE INTERNATIONALE ============ -->
<section class="hm-world">
  <div class="container hm-world-grid">
    <div class="hm-globe reveal" aria-hidden="true">
      <svg viewBox="0 0 520 520">
        <defs>
          <radialGradient id="hm-globe-g" cx="38%" cy="32%" r="75%"><stop offset="0" stop-color="#1f4175" stop-opacity=".95"/><stop offset=".6" stop-color="#0f2140" stop-opacity=".9"/><stop offset="1" stop-color="#050d1c"/></radialGradient>
          <clipPath id="hm-globe-c"><circle cx="260" cy="260" r="200"/></clipPath>
        </defs>
        <circle class="orbit" cx="260" cy="260" r="246"/><circle class="orbit o2" cx="260" cy="260" r="222"/>
        <circle cx="260" cy="260" r="200" fill="url(#hm-globe-g)" stroke="rgba(255,255,255,.18)"/>
        <g clip-path="url(#hm-globe-c)" class="grat">
          <% [40, 80, 120, 160].forEach(function (rx) { %><ellipse cx="260" cy="260" rx="<%= rx %>" ry="200"/><% }) %>
          <% [-150, -100, -50, 0, 50, 100, 150].forEach(function (dy) { var w = Math.sqrt(200 * 200 - dy * dy); %><ellipse cx="260" cy="<%= 260 + dy %>" rx="<%= w.toFixed(1) %>" ry="<%= (w * 0.16).toFixed(1) %>"/><% }) %>
          <line x1="260" y1="60" x2="260" y2="460"/>
        </g>
        <% var nodes = [[150, 190], [215, 300], [262, 168], [300, 252], [352, 205], [385, 300], [318, 362], [185, 372]]; var links = [[0, 2], [2, 4], [0, 3], [3, 5], [1, 3], [3, 6], [4, 5], [1, 7], [2, 3]]; %>
        <% links.forEach(function (l, i) { var a = nodes[l[0]], b = nodes[l[1]], mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2 - 46; %><path class="arc" style="animation-delay:<%= i * 0.35 %>s" d="M<%= a[0] %> <%= a[1] %> Q<%= mx %> <%= my %> <%= b[0] %> <%= b[1] %>"/><% }) %>
        <% nodes.forEach(function (n, i) { %><circle class="pulse" style="animation-delay:<%= i * 0.4 %>s" cx="<%= n[0] %>" cy="<%= n[1] %>" r="9"/><circle class="node" cx="<%= n[0] %>" cy="<%= n[1] %>" r="4"/><% }) %>
      </svg>
    </div>
    <div>
      <div class="eyebrow reveal"><%= pick(H.world.eyebrow) %></div>
      <h2 class="reveal"><%= pick(H.world.title) %></h2>
      <p class="reveal"><%= pick(H.world.sub) %></p>
      <% if (reach.projects) { %>
      <dl class="hm-reach reveal">
        <div><dt><%= reach.projects %></dt><dd><%= pick(H.world.statOpps) %></dd></div>
        <div><dt><%= reach.countries %></dt><dd><%= pick(H.world.statCountries) %></dd></div>
        <div><dt><%= reach.sectors %></dt><dd><%= pick(H.world.statSectors) %></dd></div>
      </dl>
      <% } %>
      <ul class="hm-sectors reveal">
        <% H.world.sectors.forEach(function (s) { %><li><%- include('../partials/icon', { name: s.icon, size: 16 }) %><%= pick(s.label) %></li><% }) %>
      </ul>
    </div>
  </div>
</section>

<% if (news.length) { %>
<!-- ============ ACTUALITÉS ============ -->
<section class="section hm-news">
  <div class="container">
    <div class="hm-head-row">
      <div>
        <div class="eyebrow eyebrow-dark reveal"><%= pick(H.news.eyebrow) %></div>
        <h2 class="reveal"><%= pick(H.news.title) %></h2>
        <p class="reveal"><%= pick(H.news.sub) %></p>
      </div>
      <a class="btn btn-ghost" href="/news"><%= pick(H.news.all) %> <%- arrow(16) %></a>
    </div>
    <div class="grid grid-3 mt-3">
      <% news.forEach(function (n, i) { %><div class="reveal" style="--d:<%= i * 90 %>ms"><%- include('../partials/news-card', { n: n }) %></div><% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============ APPEL À L'ACTION ============ -->
<% var cta = photo('skyline'); %>
<section class="cta-band hm-cta">
  <img src="<%= cta.large %>" srcset="<%= cta.small %> 800w, <%= cta.large %> 1600w" sizes="100vw" alt="" loading="lazy" decoding="async">
  <div class="container cta-inner reveal">
    <h2><%= pick(H.cta.title) %></h2>
    <p><%= pick(H.cta.sub) %></p>
    <div class="hero-cta">
      <a class="btn btn-emerald btn-lg" href="/opportunities"><%= pick(H.cta.b1) %> <%- arrow(18) %></a>
      <a class="btn btn-gold btn-lg" href="/submit-project"><%= pick(H.cta.b2) %></a>
      <a class="btn btn-glass btn-lg" href="/contact"><%= pick(H.cta.b3) %></a>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
