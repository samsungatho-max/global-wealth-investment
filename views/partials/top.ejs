<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' — ' + site : site + ' — ' + t('slogan') %></title>
  <meta name="description" content="<%= t('hero.subtitle') %>">
  <meta name="theme-color" content="#0a1628">
  <meta name="application-name" content="<%= site %>">
  <meta name="apple-mobile-web-app-title" content="Synergix">
  <meta property="og:site_name" content="<%= site %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title ? title + ' — ' + site : site + ' — ' + t('slogan') %>">
  <meta property="og:description" content="<%= t('hero.subtitle') %>">
  <meta property="og:image" content="<%= baseUrl %>/static/img/brand/synergix-partage-1200x630.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/img/brand/synergix-icone-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/static/img/brand/synergix-icone-180.png">
  <link rel="manifest" href="/static/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="stylesheet" href="/static/css/photos.css">
  <link rel="stylesheet" href="/static/css/news.css">
  <script src="/static/js/boot.js"></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="<%= site %>">
      <%- include('logo') %>
      <span class="brand-name">Synergix<small>Company Partners</small></span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>><%= t('nav.home') %></a>
      <a href="/opportunities" <%- path.startsWith('/opportunities') ? 'aria-current="page"' : '' %>><%= t('nav.opportunities') %></a>
      <a href="/simulator" <%- path === '/simulator' ? 'aria-current="page"' : '' %>><%= t('nav.simulator') %></a>
      <a href="/news" <%- path.startsWith('/news') ? 'aria-current="page"' : '' %>><%= t('nav.news') %></a>
      <a href="/page/about" <%- path === '/page/about' ? 'aria-current="page"' : '' %>><%= t('nav.about') %></a>
      <a href="/contact" <%- path === '/contact' ? 'aria-current="page"' : '' %>><%= t('nav.contact') %></a>
    </nav>
    <div class="header-tools">
      <details class="dropdown">
        <summary aria-label="<%= t('nav.language') %>"><%= lang.toUpperCase() %> ▾</summary>
        <div class="dropdown-menu">
          <% languages.forEach(function (l) { %>
            <a href="<%= langUrl(l.code) %>" hreflang="<%= l.code %>" lang="<%= l.code %>" <%- l.code === lang ? 'aria-current="true"' : '' %>><%= l.name %></a>
          <% }) %>
        </div>
      </details>
      <% if (currencies.length > 1) { %>
      <details class="dropdown">
        <summary aria-label="<%= t('nav.currency') %>"><%= currency === 'XOF' ? 'FCFA' : currency %> ▾</summary>
        <div class="dropdown-menu">
          <% currencies.forEach(function (c) { %>
            <a href="<%= curUrl(c.code) %>" <%- c.code === currency ? 'aria-current="true"' : '' %>><%= c.label %></a>
          <% }) %>
        </div>
      </details>
      <% } %>
      <div class="header-auth">
        <% if (user) { %>
          <% if (user.role === 'admin') { %><a class="header-link" href="/admin"><%= t('nav.admin') %></a><% } %>
          <a class="header-link" href="/account/notifications" aria-label="<%= t('nav.notifications') %>">🔔 <% if (unread) { %><span class="badge-dot"><%= unread %></span><% } %></a>
          <a class="btn btn-gold" href="/account"><%= t('nav.account') %></a>
          <form method="post" action="/logout" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-btn" type="submit" title="<%= t('nav.logout') %>" aria-label="<%= t('nav.logout') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg></button></form>
        <% } else { %>
          <a class="header-link" href="/login"><%= t('nav.login') %></a>
          <a class="btn btn-gold" href="/register"><%= t('nav.register') %></a>
        <% } %>
      </div>
      <button class="menu-toggle" type="button" data-menu-toggle aria-controls="mobile-nav" aria-expanded="false" aria-label="<%= t('nav.menu') %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile">
    <a href="/"><%= t('nav.home') %></a>
    <a href="/opportunities"><%= t('nav.opportunities') %></a>
    <a href="/simulator"><%= t('nav.simulator') %></a>
    <a href="/news"><%= t('nav.news') %></a>
    <a href="/page/about"><%= t('nav.about') %></a>
    <a href="/contact"><%= t('nav.contact') %></a>
    <% if (user) { %>
      <% if (user.role === 'admin') { %><a href="/admin"><%= t('nav.admin') %></a><% } %>
      <a href="/account/notifications"><%= t('nav.notifications') %> <% if (unread) { %><span class="badge-dot"><%= unread %></span><% } %></a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-btn" type="submit"><%= t('nav.logout') %></button></form>
      <a class="btn btn-gold btn-block" href="/account"><%= t('nav.account') %></a>
    <% } else { %>
      <a href="/login"><%= t('nav.login') %></a>
      <a class="btn btn-gold btn-block" href="/register"><%= t('nav.register') %></a>
    <% } %>
  </nav>
</header>
<main id="main">
<% if (flash.length) { %>
  <div class="container flash-wrap">
    <% flash.forEach(function (f) { %><div class="alert alert-<%= f.type %>" role="status"><%= f.msg %></div><% }) %>
  </div>
<% } %>
