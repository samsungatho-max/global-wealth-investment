<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' — ' + site : site + ' — ' + t('slogan') %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : t('site.hero_sub') %>">
  <link rel="canonical" href="<%= baseUrl %><%= path === '/' ? '' : path %>">
  <meta name="theme-color" content="#0a1628">
  <meta name="application-name" content="<%= site %>">
  <meta name="apple-mobile-web-app-title" content="Globacor">
  <meta property="og:site_name" content="<%= site %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title ? title + ' — ' + site : site + ' — ' + t('slogan') %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : t('site.hero_sub') %>">
  <meta property="og:image" content="<%= baseUrl %>/static/img/brand/globacor-partage-1200x630.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/img/brand/globacor-icone-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/static/img/brand/globacor-icone-180.png">
  <link rel="manifest" href="/static/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/static/css/photos.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/static/css/news.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/static/css/contact.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/static/css/nav.css?v=<%= assetV %>">
  <script src="/static/js/boot.js?v=<%= assetV %>"></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="<%= site %>">
      <%- include('logo') %>
      <span class="brand-name">Globacor<small>Partners Inc</small></span>
    </a>
    <nav class="gnav" aria-label="Main">
      <% nav.groups.forEach(function (g) { %>
        <div class="gnav-item" <%- g.items.length ? 'data-nav-item' : '' %>>
          <% if (g.items.length) { %>
            <button class="gnav-link<%= g.current ? ' is-current' : '' %>" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-<%= g.id %>"><%= g.label %><svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
            <div class="gnav-panel<%= g.wide ? ' wide' : '' %>" id="nav-<%= g.id %>">
              <div class="gnav-head"><strong><%= g.label %></strong><span><%= g.intro %></span></div>
              <div class="gnav-list">
                <% g.items.forEach(function (i) { %>
                  <a class="gnav-entry" href="<%= i.href %>"><span class="gnav-ico"><%- include('icon', { name: i.icon, size: 18 }) %></span><span class="gnav-txt"><b><%= i.label %></b><% if (i.note) { %><small><%= i.note %></small><% } %></span></a>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <a class="gnav-link" href="<%= g.href %>" <%- g.current ? 'aria-current="page"' : '' %>><%= g.label %></a>
          <% } %>
        </div>
      <% }) %>
    </nav>
    <div class="header-tools">
      <% if (languages.length > 1) { %>
      <details class="dropdown">
        <summary aria-label="<%= t('nav.language') %>"><%= lang.toUpperCase() %><svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="dropdown-menu">
          <% languages.forEach(function (l) { %>
            <a href="<%= langUrl(l.code) %>" rel="nofollow" hreflang="<%= l.code %>" lang="<%= l.code %>" <%- l.code === lang ? 'aria-current="true"' : '' %>><%= l.name %></a>
          <% }) %>
        </div>
      </details>
      <% } %>
      <% if (currencies.length > 1) { %>
      <details class="dropdown">
        <summary aria-label="<%= t('nav.currency') %>"><%= currency === 'XOF' ? 'FCFA' : currency %><svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="dropdown-menu">
          <% currencies.forEach(function (c) { %>
            <a href="<%= curUrl(c.code) %>" rel="nofollow" <%- c.code === currency ? 'aria-current="true"' : '' %>><%= c.label %></a>
          <% }) %>
        </div>
      </details>
      <% } %>
      <div class="header-cta<%= user ? ' is-auth' : '' %>">
        <% if (user && user.role === 'admin') { %><a class="header-admin" href="/admin"><%= t('nav.admin') %></a><% } %>
        <% if (user) { %><a class="header-ico" href="/account/notifications" title="<%= t('nav.notifications') %>" aria-label="<%= t('nav.notifications') %>"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 01-3.4 0"/></svg><% if (unread) { %><span class="badge-dot"><%= unread %></span><% } %></a><% } %>
        <a class="btn btn-line" href="/submit-project"><%= nav.text.submit %></a>
        <a class="btn btn-emerald" href="<%= user ? '/account' : '/login' %>"><%- include('icon', { name: 'user', size: 16 }) %><%= nav.text.client %></a>
        <% if (user) { %><form method="post" action="/logout" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="header-ico" type="submit" title="<%= t('nav.logout') %>" aria-label="<%= t('nav.logout') %>"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg></button></form><% } %>
      </div>
      <button class="nav-burger" type="button" data-menu-toggle aria-controls="mobile-nav" aria-expanded="false" aria-label="<%= t('nav.menu') %>">
        <svg class="i-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="i-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mnav" aria-label="Mobile">
    <div class="mnav-inner">
      <% nav.groups.forEach(function (g) { %>
        <% if (g.items.length) { %>
          <details class="mnav-group" <%- g.current ? 'open' : '' %>>
            <summary><%= g.label %><svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="mnav-sub">
              <% g.items.forEach(function (i) { %><a href="<%= i.href %>"><span class="gnav-ico"><%- include('icon', { name: i.icon, size: 17 }) %></span><%= i.label %></a><% }) %>
            </div>
          </details>
        <% } else { %>
          <a class="mnav-link" href="<%= g.href %>" <%- g.current ? 'aria-current="page"' : '' %>><%= g.label %></a>
        <% } %>
      <% }) %>
      <div class="mnav-cta">
        <a class="btn btn-emerald" href="<%= user ? '/account' : '/login' %>"><%- include('icon', { name: 'user', size: 18 }) %><%= nav.text.client %></a>
        <a class="btn btn-gold" href="/submit-project"><%= nav.text.submit %></a>
        <a class="btn btn-line" href="/solutions"><%= nav.text.solutions %></a>
      </div>
      <div class="mnav-user">
        <% if (user) { %>
          <% if (user.role === 'admin') { %><a href="/admin"><%= t('nav.admin') %></a><% } %>
          <a href="/account/notifications"><%= t('nav.notifications') %> <% if (unread) { %><span class="badge-dot"><%= unread %></span><% } %></a>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-btn" type="submit"><%= t('nav.logout') %></button></form>
        <% } else { %>
          <a href="/login"><%= t('nav.login') %></a>
          <a href="/register"><%= t('nav.register') %></a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
<main id="main">
<% if (flash.length) { %>
  <div class="container flash-wrap">
    <% flash.forEach(function (f) { %><div class="alert alert-<%= f.type %>" role="status"><%= f.msg %></div><% }) %>
  </div>
<% } %>
