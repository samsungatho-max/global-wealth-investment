<nav class="side-nav adm-nav" aria-label="Administration">
  <% var badge = typeof navCounts !== 'undefined' ? navCounts : {};
  [
    ['Pilotage', [['/admin', 'Tableau de bord', 'chart']]],
    ['Clients', [['/admin/users', 'Comptes clients', 'users'], ['/admin/kyc', 'Vérifications d\'identité', 'idcard', 'kyc']]],
    ['Opérations financières', [['/admin/deposits', 'Dépôts', 'wallet', 'deposits'], ['/admin/withdrawals', 'Retraits', 'swap', 'withdrawals'], ['/admin/transactions', 'Toutes les transactions', 'file']]],
    ['Activité', [['/admin/projects', 'Projets', 'building'], ['/admin/requests', 'Demandes et dossiers', 'book', 'requests'], ['/admin/interests', 'Intérêts manifestés', 'eye', 'interests'], ['/admin/messages', 'Messages clients', 'user', 'messages']]],
    ['Contenus', [['/admin/news', 'Actualités & rapports', 'globe'], ['/admin/news-watch', 'Veille des sources', 'search'], ['/admin/pages', 'Pages institutionnelles', 'file']]],
    ['Contrôle', [['/admin/audit', 'Journal d\'audit', 'shield'], ['/admin/logins', 'Connexions', 'lock'], ['/admin/emails', 'E-mails envoyés', 'clock'], ['/admin/settings', 'Paramètres', 'cpu']]]
  ].forEach(function (g) { %>
    <div class="nav-title"><%= g[0] %></div>
    <% g[1].forEach(function (item) {
      var current = item[0] === '/admin' ? path === '/admin' || path === '/admin/' : (path === item[0] || path.indexOf(item[0] + '/') === 0); %>
      <a href="<%= item[0] %>" <%- current ? 'aria-current="page"' : '' %>><span class="adm-nav-l"><%- include('icon', { name: item[2], size: 17 }) %><%= item[1] %></span><% if (item[3] && badge[item[3]]) { %><span class="badge-dot"><%= badge[item[3]] %></span><% } %></a>
    <% }) %>
  <% }) %>
  <div class="nav-title">Site</div>
  <a href="/" target="_blank"><span class="adm-nav-l"><%- include('icon', { name: 'arrow', size: 17 }) %>Voir le site public</span></a>
  <a href="/account/security"><span class="adm-nav-l"><%- include('icon', { name: 'lock', size: 17 }) %>Ma sécurité (2FA)</span></a>
</nav>
