<%# Photo responsive (WebP 800/1600), chargement différé, libellé « photo d'illustration » optionnel.
    Paramètres : p (objet photo), sizes, eager, label (texte), cls %>
<% var _sizes = typeof sizes !== 'undefined' ? sizes : '(min-width: 1000px) 50vw, 100vw'; %>
<figure class="ph <%= typeof cls !== 'undefined' ? cls : '' %>">
  <img src="<%= p.small %>" srcset="<%= p.small %> 800w, <%= p.large %> 1600w" sizes="<%= _sizes %>"
       alt="<%= p.alt %>" width="1600" height="900" decoding="async"
       <%- typeof eager !== 'undefined' && eager ? 'fetchpriority="high"' : 'loading="lazy"' %>>
</figure>
