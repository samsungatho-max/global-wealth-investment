      <div>
        <a class="brand" href="/" style="margin-bottom:16px"><%- include('logo') %><span class="brand-name">Globacor<small>Partners Inc</small></span></a>
        <p><%= t('slogan') %></p>
        <p class="small"><%= t('footer.disclaimer') %></p>
      </div>
      <div>
        <h4><%= t('footer.col_company') %></h4>
        <ul>
          <li><a href="/company"><%= t('site.nav_company') %></a></li>
          <li><a href="/markets"><%= t('site.nav_markets') %></a></li>
          <li><a href="/news"><%= t('nav.news') %></a></li>
          <li><a href="/page/faq"><%= t('footer.faq') %></a></li>
          <li><a href="/contact"><%= t('footer.contact') %></a></li>
        </ul>
      </div>
      <div>
        <h4><%= t('footer.col_invest') %></h4>
        <ul>
          <li><a href="/solutions"><%= t('site.nav_solutions') %></a></li>
          <li><a href="/fund-management"><%= t('site.nav_fund') %></a></li>
          <li><a href="/submit-project"><%= t('site.cta_submit') %></a></li>
          <li><a href="/page/sectors"><%= t('footer.sectors') %></a></li>
          <li><a href="/page/risks"><%= t('footer.risks') %></a></li>
          <li><a href="/simulator"><%= t('nav.simulator') %></a></li>
        </ul>
      </div>
      <div>
