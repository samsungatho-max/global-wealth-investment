          <li><a href="/page/legal"><%= t('footer.legal') %></a></li>
          <li><a href="/page/terms"><%= t('footer.terms') %></a></li>
          <li><a href="/page/privacy"><%= t('footer.privacy') %></a></li>
          <li><a href="/cookies"><%= t('site.cookies_title') %></a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
