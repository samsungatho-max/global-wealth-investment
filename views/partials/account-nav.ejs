<nav class="side-nav" aria-label="<%= t('account.title') %>">
  <div class="nav-title"><%= t('account.title') %></div>
  <%
    var items = [['/account', t('account.nav_overview')], ['/account/requests', t('site.acc_requests')]];
    if (fundsEnabled) items.push(['/account/investments', t('account.nav_investments')], ['/account/transactions', t('account.nav_transactions')], ['/account/deposit', t('account.nav_deposit')], ['/account/withdraw', t('account.nav_withdraw')]);
    items.push(['/account/documents', t('account.nav_documents')]);
    if (fundsEnabled) items.push(['/account/kyc', t('account.nav_kyc')]);
    items.push(['/account/notifications', t('account.nav_notifications')], ['/account/security', t('account.nav_security')]);
    items.forEach(function (item) {
      var full = path.replace(/\/$/, '');
      var current = item[0] === '/account' ? full === '/account' : full.indexOf(item[0]) === 0; %>
    <a href="<%= item[0] %>" <%- current ? 'aria-current="page"' : '' %>>
      <span><%= item[1] %></span>
      <% if (item[0] === '/account/kyc' && user.kyc_status !== 'approved') { %><span class="badge-dot">!</span><% } %>
      <% if (item[0] === '/account/notifications' && unread) { %><span class="badge-dot"><%= unread %></span><% } %>
    </a>
  <% }) %>
</nav>
