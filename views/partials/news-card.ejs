<%# Carte d'actualité / rapport. Paramètres : n (publication décorée), big (optionnel) %>
<% var np = n.image_path ? null : photo(n.photo); var src0 = n.sourceList && n.sourceList[0]; %>
<article class="card news-card<%= typeof big !== 'undefined' && big ? ' news-card-big' : '' %>">
  <a class="news-media" href="/news/<%= n.slug %>" tabindex="-1" aria-hidden="true">
    <% if (n.image_path) { %><img src="/media/<%= n.image_path %>" alt="" loading="lazy" decoding="async"><% } else { %><img src="<%= np.small %>" <%- typeof big !== 'undefined' && big ? 'srcset="' + np.small + ' 800w, ' + np.large + ' 1600w" sizes="(min-width: 1000px) 60vw, 100vw"' : '' %> alt="" loading="lazy" decoding="async" width="800" height="600"><% } %>
    <span class="news-kind <%= n.kind %>"><%= t('news.' + n.kind) %></span>
  </a>
  <div class="news-body">
    <div class="news-meta">
      <span class="chip chip-gold"><%= t('news.region.' + n.region) %></span>
      <span class="chip"><%= t('news.sector.' + n.sector) %></span>
      <time datetime="<%= String(n.date).slice(0, 10) %>"><%= fmtDate(n.date) %></time>
    </div>
    <h3><a href="/news/<%= n.slug %>"><%= n.tr.title %></a></h3>
    <p class="news-summary"><%= n.tr.summary %></p>
    <% if (src0) { %><p class="news-source"><%= t('news.source') %> : <%= src0.name.split(' — ')[0] %></p><% } %>
  </div>
</article>
