<article class="card news-card">
  <a class="news-media" href="/news/<%= n.slug %>" tabindex="-1" aria-hidden="true" style="display:block">
    <% if (n.image_path) { %><img src="/media/<%= n.image_path %>" alt="" loading="lazy"><% } else { var np = photo(n.kind === 'report' ? 'graphiques' : 'immeuble-2'); %><img src="<%= np.small %>" alt="" loading="lazy" decoding="async" width="800" height="600"><% } %>
  </a>
  <div class="news-body">
    <div class="flex small muted"><span class="chip chip-gold"><%= t('news.' + n.kind) %></span><span><%= fmtDate(n.published_at) %></span></div>
    <h3 class="mt-1"><a href="/news/<%= n.slug %>" style="text-decoration:none;color:inherit"><%= n.tr.title %></a></h3>
    <p class="small muted mb-0"><%= n.tr.summary %></p>
  </div>
</article>
