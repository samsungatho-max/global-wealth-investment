# Copier ce fichier en .env et adapter les valeurs.

# Environnement : production active les cookies sécurisés, HSTS et le cache des vues
NODE_ENV=development
PORT=3000
# URL publique du site (utilisée dans les e-mails)
BASE_URL=http://localhost:3000
# Obligatoire en production : chaîne aléatoire d'au moins 32 caractères
SESSION_SECRET=
# Si le site est derrière un proxy HTTPS (Nginx, Caddy, hébergeur…)
TRUST_PROXY=

# Compte administrateur créé au premier démarrage (si absent : mot de passe généré dans data/initial-admin.txt)
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# Fiches de démonstration au premier démarrage (false pour ne pas les créer)
SEED_DEMO=true

# ---------- E-mails (OBLIGATOIRE pour que les clients reçoivent leur code) ----------
# Sans SMTP_HOST, AUCUN e-mail ne part : ils sont marqués « non envoyé » dans Admin > E-mails.
# Exemple Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false,
#                 SMTP_USER=<identifiant SMTP Brevo>, SMTP_PASS=<clé SMTP Brevo>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse d'un domaine VOUS appartenant, authentifié chez le service d'envoi (SPF + DKIM + DMARC).
# Jamais une adresse @gmail.com / @outlook.com : elle serait rejetée ou classée en spam.
MAIL_FROM="Global Wealth Investment <no-reply@votre-domaine.com>"
MAIL_REPLY_TO=
# Jeton secret du webhook de suivi (remise / rebonds) : https://votre-domaine/webhooks/email?token=<jeton>
EMAIL_WEBHOOK_TOKEN=
# Facultatif : signature DKIM faite par l'application (inutile si le service d'envoi signe déjà)
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=
# Clé secrète pour le hachage des codes de confirmation (sinon SESSION_SECRET est utilisé)
CODE_PEPPER=

# Base PostgreSQL (production : fournie par Neon/Vercel). Vide = PostgreSQL embarqué dans DATA_DIR/pgdata.
DATABASE_URL=
# Taille maximale d'un fichier téléversé, en Mo (Vercel : 4 au maximum)
UPLOAD_MAX_MB=4

# Emplacements de la base embarquée (développement) et des sauvegardes
DATA_DIR=
BACKUP_DIR=
